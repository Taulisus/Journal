# ============================================================
# Переменные окружения для Journal
# ============================================================
# Файл НЕ в git (см. .gitignore).
# Скопируйте .env.example -> .env и заполните значения.
# ============================================================

# Секретный ключ Flask (обязателен).
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ВСТАВЬТЕ_СЮДА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ

# Начальный пароль для admin.
# Используется ТОЛЬКО при первом создании БД (когда таблица users пуста).
# Если оставить пустым — сгенерируется случайный и покажется один раз в консоли.
ADMIN_INITIAL_PASSWORD=

# Хост и порт для запуска приложения.
# 127.0.0.1 — только с этой машины.
# 192.168.3.5 — доступно в локальной сети (ваш текущий дефолт в config.py).
FLASK_HOST=192.168.3.5
FLASK_PORT=5000

# Debug-режим Flask.
# false — для повседневной работы.
# true  — для отладки (показывает traceback в браузере, НЕ включайте в сети).
FLASK_DEBUG=false