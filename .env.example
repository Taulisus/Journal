# ============================================================
# Шаблон переменных окружения.
# Скопируйте в .env и заполните:
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (Linux/macOS)
# ============================================================

# Секретный ключ Flask.
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Начальный пароль для admin (только при первом создании БД).
# Пусто = сгенерировать случайный и показать один раз в консоли.
ADMIN_INITIAL_PASSWORD=

# Хост и порт.
# 127.0.0.1 — только локально. 192.168.3.5 или 0.0.0.0 — для сети.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Debug-режим (true — только для локальной отладки, не в сети).
FLASK_DEBUG=false